# Folder to back up
SOURCE_DIR="C:\Path\To\Folder\You\Want\To\Backup"

# Where backups are stored — a subfolder per backup run is created here,
# named "<FolderName>_<timestamp>"
BACKUP_ROOT="D:\backup"

# How many days of backups to keep before old ones are auto-deleted
RETENTION_DAYS=7

# Whether to compress each backup into a .zip (true/false)
COMPRESS=true