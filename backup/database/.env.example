# Database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# Where backups are stored. Defaults to ./backups if not set.
BACKUP_DIR=./backups

# How many days of backups to keep before old ones are auto-deleted.
RETENTION_DAYS=7