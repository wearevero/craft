WEB_URL=http://10.10.10.10
EMAIL=admin@example.com
PASSWORD=

# Path Chrome yang sudah terinstall (puppeteer-core tidak mengunduh browser sendiri,
# dan TIDAK butuh chromedriver lagi)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

OUTPUT_DIR=D:\WIP-TS

# true = tanpa jendela browser (lebih cepat). false = browser tampil & dibiarkan terbuka
HEADLESS=true

# Jumlah halaman yang di-scrape paralel
CONCURRENCY=3